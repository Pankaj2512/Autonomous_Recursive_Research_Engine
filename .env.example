# ==============================================================================
# Autonomous Recursive Research Engine - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "openai", "gemini", "groq", "ollama"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# API Keys (Provide at least one depending on your chosen LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration (if using local models)
OLLAMA_BASE_URL=http://localhost:11434

# Search Provider Configuration
# Supported: "duckduckgo" (default, free, no key needed) or "tavily"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here

# Recursive Orchestration & Budget Parameters
MAX_RECURSION_DEPTH=3
MAX_SUB_QUESTIONS=4
VERIFICATION_THRESHOLD=0.75
MAX_SEARCH_RESULTS_PER_QUERY=5

# Dynamic Context Optimization
ENABLE_CONTEXT_PRUNING=true
MAX_SNIPPET_LENGTH_CHARS=1200

# Output Paths
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
